{
    "rewrites": [
        {
            "source": "/api/nomba/(.*)",
            "destination": "https://api.nomba.com/v1/$1"
        },
        {
            "source": "/assets/:id",
            "missing": [
                {
                    "type": "query",
                    "key": "og"
                }
            ],
            "destination": "/api/seo?id=:id"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/icon.svg",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}